  </project>
  <project path="build/release" name="build_release" groups="pdk,tradefed,sysui-studio" remote="androidone" />
  <project path="build/soong" name="build_soong" groups="pdk,tradefed,sysui-studio" remote="androidone" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <!-- external -->
  <project path="external/bouncycastle" name="external_bouncycastle" groups="pdk" remote="androidone" />

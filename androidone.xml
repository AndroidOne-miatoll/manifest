<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="androidone"
           fetch="https://github.com/AndroidOne-miatoll"
           sync-c="true"
           sync-j="4"
           revision="16-qpr2" />

  <remote  name="clover-gitlab"
           fetch="https://gitlab.com/thecloverproject"
           sync-c="true"
           sync-j="4"
           revision="16-qpr2" />

  <!-- art -->
  <project path="art" name="art" groups="pdk" remote="androidone" />

  <!-- bionic -->
  <project path="bionic" name="bionic" groups="pdk" remote="androidone" />

  <!-- bootable -->
  <project path="bootable/deprecated-ota" name="bootable_deprecated-ota" groups="pdk-cw" remote="androidone" />
  <project path="bootable/recovery" name="bootable_recovery" groups="pdk" remote="androidone" />

  <!-- build -->
  <project path="build/make" name="build" groups="pdk,sysui-studio" remote="androidone" >
